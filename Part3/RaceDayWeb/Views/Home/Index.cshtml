@{
    ViewData["Title"] = "Welcome to RaceDay";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold" style="color: #0d6efd;">Welcome to RaceDay</h1>
    <p class="lead mt-3">The ultimate platform for Organisers and Participants.</p>
    
    <div class="row justify-content-center mt-5">
        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100">
                <h3>I am an Organiser</h3>
                <p class="text-muted">Create events, manage categories, and track enrolments.</p>
                <a href="/Account/Login" class="btn btn-primary mt-auto w-100">Login as Organiser</a>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100">
                <h3>I am a Participant</h3>
                <p class="text-muted">Find events, register to race, and view your results.</p>
                <a href="/Account/Login" class="btn btn-success mt-auto w-100">Login as Participant</a>
            </div>
        </div>
    </div>
</div>