@model List<RaceDayWeb.Services.ResultResponse>
@using RaceDayWeb.Services
@{
    ViewData["Title"] = "My Results";
    var enrolments = ViewBag.Enrolments as List<EnrolmentResponse>;
    var events = ViewBag.Events as List<EventResponse>;
    var categories = ViewBag.Categories as List<CategoryResponse>;
}

<div class="container mt-4">
    <h2>My Race Results</h2>
    <hr />
    
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">You don't have any race results yet. Finish a race to see your time here!</div>
    }
    else
    {
        <div class="row">
            @foreach (var r in Model)
            {
                // 1. Find the enrolment to get the Category ID
                var enrolment = enrolments?.FirstOrDefault(e => e.EnrolmentId == r.EnrolmentId);
                
                // 2. Find the Category to get the Event ID and Category Name
                var category = categories?.FirstOrDefault(c => c.CategoryId == enrolment?.CategoryId);
                
                // 3. Find the Event to get the Event Name and Date
                var ev = events?.FirstOrDefault(x => x.EventId == category?.EventId);

                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0 border-start border-4 border-success">
                        <div class="card-body">
                            <h4 class="card-title text-success">@(ev?.EventName ?? "Unknown Event")</h4>
                            <h6 class="card-subtitle mb-3 text-muted">@(ev != null ? ev.EventDate.ToString("dd MMM yyyy") : "Date N/A")</h6>
                            
                            <div class="row text-center mt-4">
                                <div class="col-4">
                                    <h6 class="text-muted mb-1">Category</h6>
                                    <span class="fw-bold">@(category?.CategoryName ?? "Unknown")</span>
                                </div>
                                <div class="col-4">
                                    <h6 class="text-muted mb-1">Time</h6>
                                    <span class="fw-bold fs-5">@r.FinishTime</span>
                                </div>
                                <div class="col-4">
                                    <h6 class="text-muted mb-1">Position</h6>
                                    <span class="fw-bold fs-4 text-primary">@r.Position</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>