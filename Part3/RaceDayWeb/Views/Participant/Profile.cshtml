@model RaceDayWeb.Services.MyProfileResponse

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2>My Profile</h2>
            <hr />

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success">@ViewBag.Success</div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <div class="card shadow-sm p-4">
                <div class="text-center mb-4">
                    <!-- Placeholder for profile picture later -->
                    <img src="https://via.placeholder.com/150" class="rounded-circle mb-3 shadow" alt="Profile Picture" style="width: 150px; height: 150px; object-fit: cover;" />
                    <h5 class="text-muted">@Model.User.Email</h5>
                    <span class="badge bg-primary">Participant</span>
                </div>

                <form asp-action="Profile" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">First Name</label>
                        <!-- Note: You need to add FirstName and LastName to UserInfo in ApiService if they are missing -->
                        <input type="text" name="firstName" class="form-control" value="@Model.User.FirstName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Last Name</label>
                        <input type="text" name="lastName" class="form-control" value="@Model.User.LastName" required />
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>