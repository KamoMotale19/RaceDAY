@model List<RaceDayWeb.Services.CategoryResponse>

@{
    ViewData["Title"] = "Manage Categories";
    int eventId = ViewBag.EventId;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage Categories</h2>
        <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    <div class="row">
        <!-- Left Side: Add Form -->
        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h4>Add Category</h4>
                <form asp-action="CreateCategory" method="post">
                    <input type="hidden" name="EventId" value="@eventId" />
                    
                    <div class="mb-3">
                        <label class="form-label">Category Name</label>
                        <input name="CategoryName" class="form-control" required placeholder="e.g. 10km Run" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Distance (km)</label>
                        <input name="DistanceKm" type="number" step="0.1" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Entry Fee (R)</label>
                        <input name="EntryFee" type="number" step="0.01" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Max Participants</label>
                        <input name="MaxParticipants" type="number" class="form-control" required />
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100">Add Category</button>
                </form>
            </div>
        </div>

        <!-- Right Side: Existing Categories -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Existing Categories</h5>
                </div>
                <div class="card-body">
                    @if (Model.Count == 0)
                    {
                        <p class="text-muted">No categories added yet.</p>
                    }
                    else
                    {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Distance</th>
                                    <th>Fee</th>
                                    <th>Max Spots</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cat in Model)
                                {
                                    <tr>
                                        <td>@cat.CategoryName</td>
                                        <td>@cat.DistanceKm km</td>
                                        <td>R @cat.EntryFee</td>
                                        <td>@cat.MaxParticipants</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>