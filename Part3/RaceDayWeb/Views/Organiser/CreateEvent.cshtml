@model RaceDayWeb.Services.EventRequest

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">
    <h2>Create a New Event</h2>
    <hr />

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="row">
        <div class="col-md-8">
            <form asp-action="CreateEvent" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm">
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Event Name</label>
                    <input asp-for="EventName" class="form-control" required placeholder="e.g. Comrades Marathon" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Date & Time</label>
                        <input asp-for="EventDate" type="datetime-local" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Location</label>
                        <input asp-for="Location" class="form-control" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Event Type</label>
                        <select asp-for="EventType" class="form-select" required>
                            <option value="">-- Select Type --</option>
                            <option value="Run">Run</option>
                            <option value="Cycle">Cycle</option>
                            <option value="Walk">Walk</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Distance (km)</label>
                        <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" required />
                    </div>
                </div>

                <!-- Image upload moved down here -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Event Banner Image</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                </div>

                <!-- ONE set of buttons at the bottom -->
                <div class="mt-4">
                    <button type="submit" class="btn btn-success px-4">Create Event</button>
                    <a asp-action="Dashboard" class="btn btn-secondary ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>