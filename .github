name: Validate Docs

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  check-docs:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3

      - name: Check /docs folder exists
        run: |
          if [ ! -d "docs" ]; then
            echo "ERROR: docs folder not found"
            exit 1
          fi
          echo "SUCCESS: docs folder exists"

      - name: Check ERD.png exists
        run: |
          if [ ! -f "docs/ERD.png" ]; then
            echo "ERROR: docs/ERD.png not found"
            exit 1
          fi
          echo "SUCCESS: ERD.png exists"

      - name: Check RaceDay API Endpoint Plan.pdf exists
        run: |
          if [ ! -f "docs/RaceDay API Endpoint Plan.pdf" ]; then
            echo "ERROR: docs/RaceDay API Endpoint Plan.pdf not found"
            exit 1
          fi
          echo "SUCCESS: RaceDay API Endpoint Plan.pdf exists"

      - name: Check schema.sql exists
        run: |
          if [ ! -f "docs/schema.sql" ]; then
            echo "ERROR: docs/schema.sql not found"
            exit 1
          fi
          echo "SUCCESS: schema.sql exists"

      - name: All files present!
        run: echo "All required files are present!"
